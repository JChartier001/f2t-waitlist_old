# Convex
NEXT_PUBLIC_CONVEX_URL=
# Issuer hostname for Clerk JWT templates (no https://) — must match auth.config / Clerk dashboard
CLERK_JWT_ISSUER_DOMAIN=
# Clerk Organization id for platform admins (session claim f2tOrgId must match)
CLERK_PLATFORM_ORG_ID=

# Clerk (Organizations enabled; vendor app uses Org-scoped sessions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (Connect hosted onboarding + per-line refund Server Actions)
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# Sentry
SENTRY_DSN=

# Public app URL (vendor portal canonical origin)
NEXT_PUBLIC_APP_URL=

# Shared secret for cross-app internal calls (matches marketplace value)
INTERNAL_API_SECRET=
