{
  "name": "@workspace/marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "e2e:smoke": "playwright test --pass-with-no-tests --grep @smoke"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "@workspace/web-shared": "workspace:*",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@workspace/eslint-config": "workspace:*",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "happy-dom": "^15.11.0",
    "playwright-core": "^1.49.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
