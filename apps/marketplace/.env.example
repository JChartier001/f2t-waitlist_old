# Convex
NEXT_PUBLIC_CONVEX_URL=

# Clerk (Organizations + JWT template named "convex")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe Connect (split payments) + Stripe Tax
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Resend (transactional email — Resend SDK lives in this Next.js app, NOT Convex)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=

# Public app URL (canonical origin for emails, Stripe redirects, OG tags)
NEXT_PUBLIC_APP_URL=

# Shared secret for Convex actions calling /api/emails/send and /api/* internal routes
INTERNAL_API_SECRET=
