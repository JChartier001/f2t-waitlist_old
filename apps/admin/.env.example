# Convex
NEXT_PUBLIC_CONVEX_URL=
# Issuer hostname for Clerk JWT templates (no https://) — must match auth.config / Clerk dashboard
CLERK_JWT_ISSUER_DOMAIN=
# Clerk Organization id for platform admins (session claim f2tOrgId must match)
CLERK_PLATFORM_ORG_ID=

# Clerk ("Platform" Org membership + mandatory 2FA)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (admin discretionary refund Server Actions)
STRIPE_SECRET_KEY=

# Sentry
SENTRY_DSN=

# Public app URL (admin canonical origin)
NEXT_PUBLIC_APP_URL=

# Shared secret for cross-app internal calls
INTERNAL_API_SECRET=
